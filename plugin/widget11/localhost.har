e to https://gemthreddshpc.spc.int/thredds/wms/POP/model/country/spc/forecast/hourly/TUV/P2_Nanumanga.nc?request=GetMetadata&amp;item=layerDetails&amp;layerName=Hs\n            </Abstract>\n            <LegendURL width=\"110\" height=\"264\">\n                <Format>image/png</Format>\n                <OnlineResource xlink:type=\"simple\" xlink:href=\"https://gemthreddshpc.spc.int/thredds/wms/POP/model/country/spc/forecast/hourly/TUV/P2_Nanumanga.nc?REQUEST=GetLegendGraphic&amp;PALETTE=default&amp;LAYERS=Hs&amp;STYLES=scalar-converge-final/default\"/>\n            </LegendURL>\n        </Style>\n        <Style>\n            <Name>test</Name>\n            <Title>test</Title>\n            <Abstract>test style</Abstract>\n        </Style>\n        <Style>\n            <Name>test2/default</Name>\n            <Title>test2/default</Title>\n            <Abstract>test2 style, using the default palette.  Available palettes can be found in the response to https://gemthreddshpc.spc.int/thredds/wms/POP/model/country/spc/forecast/hourly/TUV/P2_Nanumanga.nc?request=GetMetadata&amp;item=layerDetails&amp;layerName=Hs\n            </Abstract>\n            <LegendURL width=\"110\" height=\"264\">\n                <Format>image/png</Format>\n                <OnlineResource xlink:type=\"simple\" xlink:href=\"https://gemthreddshpc.spc.int/thredds/wms/POP/model/country/spc/forecast/hourly/TUV/P2_Nanumanga.nc?REQUEST=GetLegendGraphic&amp;PALETTE=default&amp;LAYERS=Hs&amp;STYLES=test2/default\"/>\n            </LegendURL>\n        </Style>\n        <Style>\n            <Name>white-arrow</Name>\n            <Title>white-arrow</Title>\n            <Abstract>white-arrow style</Abstract>\n        </Style>\n        <Style>\n            <Name>zz</Name>\n            <Title>zz</Title>\n            <Abstract>zz style</Abstract>\n        </Style>\n        <Style>\n            <Name>zz3</Name>\n            <Title>zz3</Title>\n            <Abstract>zz3 style</Abstract>\n        </Style>\n</Layer>\n  